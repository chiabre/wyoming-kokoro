echo "📥 Downloading Kokoro models (stable source)..."

mkdir -p data

BASE_URL="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0"

download() {
    FILE=$1
    URL=$2

    echo "⬇️ Downloading $FILE..."

    rm -f "data/$FILE"

    wget -L --show-progress \
        --retry-connrefused --tries=3 --timeout=30 \
        -O "data/$FILE" "$URL"

    # safety check
    if [ ! -s "data/$FILE" ]; then
        echo "❌ Failed or empty file: $FILE"
        exit 1
    fi
}

# ----------------------------
# Voices
# ----------------------------
if [ ! -f "data/voices-v1.0.bin" ]; then
    echo "🎤 Downloading voices..."
    download "voices-v1.0.bin" "$BASE_URL/voices-v1.0.bin"
fi

# ----------------------------
# GPU CHECK
# ----------------------------
HAS_GPU=false
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
    HAS_GPU=true
fi

echo ""
if [ "$HAS_GPU" = true ]; then
    echo "🚀 NVIDIA GPU detected (CUDA available)"
else
    echo "⚠️ No NVIDIA GPU detected (CPU-only system)"
fi

# ----------------------------
# MODEL SELECTION
# ----------------------------
echo ""
echo "🧠 Choose Kokoro model:"
echo "--------------------------------------------"
echo "1) FP16 (GPU)  - Fast, best quality (requires NVIDIA GPU)"
echo "2) FP32 (CPU)  - Most compatible"
echo "3) INT8        - Low-power / edge devices"
echo "--------------------------------------------"

read -p "Enter choice [1-3] (default: 1): " MODEL_CHOICE

case "$MODEL_CHOICE" in
    2)
        MODEL_FILE="kokoro-v1.0.onnx"
        ;;
    3)
        MODEL_FILE="kokoro-v1.0.int8.onnx"
        ;;
    *)
        MODEL_FILE="kokoro-v1.0.fp16.onnx"
        ;;
esac

echo ""
echo "📦 Selected: $MODEL_FILE"

# ----------------------------
# GPU WARNING
# ----------------------------
if [[ "$MODEL_FILE" == *"fp16"* && "$HAS_GPU" = false ]]; then
    echo ""
    echo "⚠️ WARNING: FP16 selected but no GPU detected"
    read -p "Continue? (y/N): " CONFIRM
    if [[ "$CONFIRM" != "y" && "$CONFIRM" != "Y" ]]; then
        echo "↩️ Switching to FP32..."
        MODEL_FILE="kokoro-v1.0.onnx"
    fi
fi

# ----------------------------
# DOWNLOAD MODEL
# ----------------------------
if [ ! -f "data/$MODEL_FILE" ]; then
    download "$MODEL_FILE" "$BASE_URL/$MODEL_FILE"
fi

echo ""
echo "✅ Model ready: $MODEL_FILE"
echo "✅ Voices ready: voices-v1.0.bin"
