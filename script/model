#!/usr/bin/env bash
set -e

echo "📥 Kokoro model installer"

mkdir -p data
BASE_URL="https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0"

download() {
    local FILE=$1
    local URL=$2

    echo "⬇️ $FILE"

    rm -f "data/$FILE"
    wget -q --show-progress -O "data/$FILE" "$URL"

    if [ ! -s "data/$FILE" ]; then
        echo "❌ failed: $FILE"
        exit 1
    fi
}

# ----------------------------
# ALWAYS CLEAN OLD MODELS
# ----------------------------
echo "🧹 Removing old models..."
rm -f data/*.onnx

# voices (single source of truth)
if [ ! -f "data/voices-v1.0.bin" ]; then
    download "voices-v1.0.bin" "$BASE_URL/voices-v1.0.bin"
fi

# GPU check
HAS_GPU=false
if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
    HAS_GPU=true
fi

echo "Select model:"
echo "1) FP16 (GPU)"
echo "2) FP32 (CPU)"
echo "3) INT8"

read -p "Choice [1-3] (default 1): " CHOICE

case "$CHOICE" in
    2) MODEL="kokoro-v1.0.onnx" ;;
    3) MODEL="kokoro-v1.0.int8.onnx" ;;
    *) MODEL="kokoro-v1.0.fp16.onnx" ;;
esac

if [[ "$MODEL" == *fp16* && "$HAS_GPU" = false ]]; then
    echo "⚠️ FP16 selected but no GPU → fallback to CPU model"
    MODEL="kokoro-v1.0.onnx"
fi

download "$MODEL" "$BASE_URL/$MODEL"

echo "✅ Active model: $MODEL"
echo "✅ Voices ready"
