#!/usr/bin/env bash
set -e

echo "📦 Installing system dependencies..."
sudo apt-get update && sudo apt-get install -y espeak-ng python3-venv

echo "🐍 Creating virtual environment..."
python3 -m venv .venv
source .venv/bin/activate
pip install --upgrade pip

if command -v nvidia-smi &> /dev/null; then
    echo "🚀 GPU Detected. Installing GPU requirements..."
    pip install onnxruntime-gpu kokoro-onnx wyoming
else
    echo "🐌 No GPU detected. Installing CPU requirements..."
    pip install onnxruntime kokoro-onnx wyoming
fi

mkdir -p data

echo "✅ Setup complete. Don't forget to download your models into the /data folder!"
