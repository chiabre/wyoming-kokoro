#!/usr/bin/env bash
set -e

echo "--- Kokoro Wyoming TTS Setup ---"

DISTRO=$(. /etc/os-release; echo "$ID")
VERSION_ID=$(. /etc/os-release; echo "$VERSION_ID" | tr -d '.')
ARCH="x86_64"

echo "📦 Installing system dependencies..."
sudo apt-get update && sudo apt-get install -y espeak-ng python3-venv wget gnupg2

# -------------------------------------------------
# GPU detection
# -------------------------------------------------
GPU=false

if command -v nvidia-smi &> /dev/null && nvidia-smi &> /dev/null; then
    GPU=true
fi

if [ "$GPU" = true ]; then
    echo "🚀 NVIDIA GPU detected"

    case "$DISTRO" in
        debian) REPO_NAME="debian${VERSION_ID}" ;;
        ubuntu) REPO_NAME="ubuntu${VERSION_ID}" ;;
        *) echo "❌ Unsupported distro: $DISTRO"; exit 1 ;;
    esac

    wget -q "https://developer.download.nvidia.com/compute/cuda/repos/${REPO_NAME}/${ARCH}/cuda-keyring_1.1-1_all.deb" -O cuda-keyring.deb
    sudo dpkg -i cuda-keyring.deb
    rm cuda-keyring.deb

    sudo apt update
    sudo apt-get install -y cuda-toolkit-12-6 cudnn9-cuda-12

    export PATH=/usr/local/cuda/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

else
    echo "🐌 CPU mode detected"
fi

# -------------------------------------------------
# Python env
# -------------------------------------------------
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
VENV_DIR="$PROJECT_ROOT/.venv"

python3 -m venv "$VENV_DIR"
source "$VENV_DIR/bin/activate"

pip install --upgrade pip wheel
pip install -r "$PROJECT_ROOT/requirements.txt"

if [ "$GPU" = true ]; then
    echo "🎮 Installing GPU runtime"
    pip uninstall -y onnxruntime || true
    pip install --no-cache-dir onnxruntime-gpu==1.25.1
fi

mkdir -p data

chmod +x "$SCRIPT_DIR/run" "$SCRIPT_DIR/install-service" "$SCRIPT_DIR/model"

echo "-------------------------------------------------------"
echo "✅ Setup complete"
echo "-------------------------------------------------------"
