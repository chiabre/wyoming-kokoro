#!/usr/bin/env bash
set -e

SERVICE="wyoming-kokoro"

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
ROOT="$(dirname "$SCRIPT_DIR")"

USER=${SUDO_USER:-$(logname 2>/dev/null || echo $USER)}
GROUP=$(id -gn "$USER")

echo "Installing $SERVICE for $USER"

sudo bash -c "cat > /etc/systemd/system/$SERVICE.service" <<EOF
[Unit]
Description=Wyoming Kokoro TTS
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=$USER
Group=$GROUP
WorkingDirectory=$ROOT

# ---------------- GPU ----------------
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64"
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="CUDA_MODULE_LOADING=LAZY"

# ---------------- Python ----------------
Environment="PYTHONUNBUFFERED=1"
Environment="OMP_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"

# ---------------- HA LATENCY TUNING ----------------
Nice=-5
IOSchedulingClass=realtime
IOSchedulingPriority=0

# ---------------- RESOURCE LIMITS ----------------
CPUQuota=200%
MemoryMax=2G

ExecStart=$ROOT/script/run

Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
EOF

sudo chmod 644 /etc/systemd/system/$SERVICE.service
sudo systemctl daemon-reload
sudo systemctl enable $SERVICE
sudo systemctl restart $SERVICE

echo "-------------------------------------------------------"
echo "✅ $SERVICE running"
echo "-------------------------------------------------------"
