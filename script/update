#!/usr/bin/env bash
set -e

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

echo "🔄 Updating Kokoro Wyoming TTS..."

# 1. Library updates
"$PROJECT_ROOT/.venv/bin/python3" -m pip install --upgrade pip wyoming kokoro-onnx onnxruntime-gpu


echo "🚀 Restarting service..."
sudo systemctl restart wyoming-kokoro
echo "✅ Done!"
